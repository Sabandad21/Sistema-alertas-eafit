# Copie este archivo a .env y complete los valores. El archivo .env NO se sube al repositorio.

# dev | prod  (en prod la cookie de sesión exige HTTPS)
APP_ENV=dev
# URL pública de la app; se usa en el enlace "Revisar alerta" del aviso a Teams
APP_BASE_URL=http://localhost:8000

# Base de datos. SQLite para desarrollo; PostgreSQL en el despliegue:
# DATABASE_URL=postgresql://USUARIO:CLAVE@SERVIDOR:5432/alertas
DATABASE_URL=sqlite:///./data/alertas.db
CAPTURAS_DIR=./data/capturas

# Clave para firmar las sesiones (genere una con: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=
# Clave que debe enviar el detector en la cabecera X-API-Key (genere otra igual de larga)
DETECTOR_API_KEY=
# Webhook del canal de Teams (Workflows). Si queda vacío, solo se avisa dentro de la app
TEAMS_WEBHOOK_URL=

# Criterio de aceptación de la HU-01 y costo de un equipo para el panel (entrega 2: USD 1.800 en compra masiva)
SLA_ALERTA_SEGUNDOS=30
COSTO_EQUIPO_USD=1800
SESION_HORAS=8

# Solo para scripts/seed.py (usuarios de prueba). Si queda vacío se genera una al azar y se imprime
SEED_PASSWORD=
